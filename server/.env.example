# ── DataShield Enterprise — Environment Configuration ──────────────────────
# Copy this file to .env and fill in your values before starting the server.

# PostgreSQL connection
DATABASE_URL=postgresql+asyncpg://datashield:datashield@localhost:5432/datashield

# JWT signing secret (use a strong random value in production)
JWT_SECRET_KEY=CHANGEME_USE_STRONG_SECRET_IN_PROD
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Master key for envelope encryption
# IMPORTANT: Keep this secret. Losing it means losing access to all encrypted data.
MASTER_KEY_PASSPHRASE=CHANGEME_USE_STRONG_PASSPHRASE_IN_PROD
# After first startup, copy the printed MASTER_KEY_SALT_HEX value here:
MASTER_KEY_SALT_HEX=

# Gemini AI (for executive summary reports)
GEMINI_API_KEY=

# Agent authentication token
AGENT_API_KEY=CHANGEME_AGENT_SECRET

# SMTP email alerts (optional — leave blank to disable)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=datashield@datashield.local
ALERT_EMAIL_RECIPIENTS=

# Misc
DEBUG=false
