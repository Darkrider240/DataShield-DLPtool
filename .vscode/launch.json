{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🐍 FastAPI Server (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["server.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "python": "${workspaceFolder}/venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "🖥️ Endpoint Agent GUI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "🗄️ Init Database (seed admin)",
      "type": "debugpy",
      "request": "launch",
      "module": "server.init_db",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "python": "${workspaceFolder}/venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ],
  "compounds": [
    {
      "name": "🚀 Full Stack (Server + Agent)",
      "configurations": ["🐍 FastAPI Server (debug)", "🖥️ Endpoint Agent GUI"]
    }
  ]
}
