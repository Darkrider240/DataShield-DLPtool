{
  "manifest_version": 3,
  "name": "DataShield Webmail DLP Interceptor",
  "version": "1.2",
  "description": "Scans and blocks outbound sensitive emails and attachments in Gmail and Outlook using the local DataShield DLP engine.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.office.com/*",
    "https://outlook.live.com/*",
    "http://localhost:5000/*",
    "http://localhost:8001/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.office.com/*",
        "https://outlook.live.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
